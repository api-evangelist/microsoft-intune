              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Remotely lock a managed device."
        },
        {
          "info": {
            "name": "Microsoft Intune Reset device passcode",
            "type": "http"
